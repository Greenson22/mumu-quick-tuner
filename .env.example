# Path ke MuMuManager.exe (CLI resmi MuMu Player)
MUMU_MANAGER=C:\Program Files\Netease\MuMuPlayer\nx_main\MuMuManager.exe

# Nama device yang mau diatur. Dipakai untuk mencari index secara otomatis.
MUMU_VM_NAME=helmatweu20@guru.sd.belajar.id

# Opsional: paksa index tertentu (kosongkan untuk auto-detect dari nama)
MUMU_VM_INDEX=

# Folder backup config sebelum apply (relatif ke root project atau absolut)
MUMU_BACKUP_DIR=backups

# DEBUG / INFO / WARNING / ERROR
MUMU_LOG_LEVEL=INFO

# Opsional: aplikasi yang dibuka otomatis (bisa juga diatur dari UI)
MUMU_AUTO_APP_PACKAGE=
MUMU_AUTO_OPEN_APP=false
